FROM rust:1.94.1-bookworm AS build
RUN apt-get update && apt-get install -y --no-install-recommends protobuf-compiler pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . .
ARG CARGO_BUILD_JOBS=2
ENV CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS}
RUN cargo build --locked --release -p monad-management -p monad-client -p monad-relay -p monad-test-mint && \
    cargo build --locked --release -p monad-test-mint --example demo-fund

FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl socat libssl3 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /src/target/release/monad-management /src/target/release/monad-client /src/target/release/monad-relay /src/target/release/monad-test-mint /app/bin/
COPY --from=build /src/target/release/examples/demo-fund /app/bin/examples/demo-fund
COPY monad-management/ui-tests/network-demo.mjs monad-management/ui-tests/container-demo.mjs /app/
RUN mkdir -p /var/log/monad-demo && chown node:node /var/log/monad-demo
ENV MONAD_DEMO_BIN_DIR=/app/bin MONAD_DEMO_LOG_DIR=/var/log/monad-demo MONAD_DEMO_MANUAL=0
USER node
EXPOSE 8080 1080 1081
STOPSIGNAL SIGTERM
CMD ["node", "/app/container-demo.mjs"]
